# Neon example: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

SESSION_SECRET="replace-with-a-long-random-string"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-personal-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-personal-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

GEMINI_API_KEY="Gemini API Key"

//Usefull Docker Commands
//docker compose -f docker/docker-compose.yml ps — check it’s still up
//docker compose -f docker/docker-compose.yml logs -f — watch its logs (useful once you start submitting real processing jobs)
//docker compose -f docker/docker-compose.yml down — stop and remove it when you’re done for the day
//docker compose -f docker/docker-compose.yml up -d — bring it back later (fast after the first pull, since the image is already cached)