# Neon example: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

SESSION_SECRET="replace-with-a-long-random-string"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-personal-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-personal-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Defaults to localhost:3000 in lib/nodeodm.ts if unset.
NODEODM_URL="http://localhost:3000"
