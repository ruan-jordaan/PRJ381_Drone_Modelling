generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONTRACTOR
  INSURANCE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  createdAt    DateTime @default(now())

  cases           Case[]  @relation("ContractorCases")
  insuredParties  Party[] @relation("InsurerParties")
}

enum CaseStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  MEASURED
  REPORT_DRAFTED
  REPORT_FINALIZED
}

model Case {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       CaseStatus @default(UPLOADED)
  contractorId String
  contractor   User       @relation("ContractorCases", fields: [contractorId], references: [id])

  parties      Party[]
  images       Image[]
  measurements Measurement[]

  modelUrl  String?
  narrative String?
  reportUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Party {
  id                  String  @id @default(cuid())
  caseId              String
  case                Case    @relation(fields: [caseId], references: [id])
  name                String
  vehicleRegistration String?
  contactDetails      String?

  insurerId String?
  insurer   User?   @relation("InsurerParties", fields: [insurerId], references: [id])
}

model Image {
  id               String    @id @default(cuid())
  caseId           String
  case             Case      @relation(fields: [caseId], references: [id])
  url              String
  originalFilename String
  capturedAt       DateTime?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime  @default(now())
}

model Measurement {
  id             String @id @default(cuid())
  caseId         String
  case           Case   @relation(fields: [caseId], references: [id])
  label          String
  pointAX        Float
  pointAY        Float
  pointAZ        Float
  pointBX        Float
  pointBY        Float
  pointBZ        Float
  distanceMeters Float
  createdAt      DateTime @default(now())
}
